<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>false</PublishAot>
        <!-- ReleaseGen evaluates projects at runtime via Microsoft.Build.Locator, which needs
             the .NET SDK's on-disk MSBuild. Single-file publishing bundles assemblies and breaks
             that resolution, so ReleaseGen itself must never be published as a single file. -->
        <PublishSingleFile>false</PublishSingleFile>
        <RepositoryUrl>https://github.com/alastairlundy/ReleaseGen</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/alastairlundy/ReleaseGen</PackageProjectUrl>
        <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <PackageId>ReleaseGen</PackageId>
        <ToolCommandName>releasegen</ToolCommandName>
        <Description>Opinionated .NET CLI for building, packaging, and publishing .NET projects, with cross-platform packaging targets and project-file-prioritized build settings.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <!-- Package version; bump manually before each release. -->
        <Version>0.4.1</Version>
        <Title>ReleaseGen</Title>
        <Authors>Alastair Lundy</Authors>
        <Copyright>Copyright (c) Alastair Lundy 2026</Copyright>
        <PackageReleaseNotes>
### Changed
- Dependencies: CliInvoke to 3.2.0 Beta 1, Meziantou.Analyzer to 3.0.342, Microsoft.Extensions.DependencyInjection (and Abstractions) to 11.0.0, System.CommandLine to 3.0.0, TUnit to 1.87.12.
- Documentation: condensed the command, manifest, preset, single-file, stage-handoff, and trusted-publishing docs; removed the redundant agent issue-tracker and triage-labels docs.</PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <AssemblyName>ReleaseGen</AssemblyName>
        <RootNamespace>ReleaseGen.Cli</RootNamespace>
        <AssemblyVersion>0.4.1</AssemblyVersion>
        <FileVersion>0.4.1</FileVersion>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Meziantou.Analyzer">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
      <PackageReference Include="Spectre.Console" />
      <PackageReference Include="System.CommandLine" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ReleaseGenLib\ReleaseGenLib.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Localizations\Resources.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Localizations\Resources.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Resources.resx</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
