<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>false</PublishAot>
        <!-- ReleaseGen evaluates projects at runtime via Microsoft.Build.Locator, which needs
             the .NET SDK's on-disk MSBuild. Single-file publishing bundles assemblies and breaks
             that resolution, so ReleaseGen itself must never be published as a single file. -->
        <PublishSingleFile>false</PublishSingleFile>
        <RepositoryUrl>https://github.com/alastairlundy/ReleaseGen</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/alastairlundy/ReleaseGen</PackageProjectUrl>
        <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <PackageId>ReleaseGen</PackageId>
        <ToolCommandName>releasegen</ToolCommandName>
        <Description>Opinionated .NET CLI for building, packaging, and publishing .NET projects, with cross-platform packaging targets and project-file-prioritized build settings.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <!-- Package version; bump manually before each release. -->
        <Version>0.4.0</Version>
        <Title>ReleaseGen</Title>
        <Authors>Alastair Lundy</Authors>
        <Copyright>Copyright (c) Alastair Lundy 2026</Copyright>
        <PackageReleaseNotes># Changes since 0.3.0

            ## Added
            - **NuGet API key via environment on .NET SDK 10.0.300+** — `publish` now delivers the API key to `dotnet nuget push` through the `NUGET_API_KEY` environment variable on .NET SDK 10.0.300+ (NuGet 7.6), so it never appears on the command line or in the process listing; older .NET SDKs (or an unresponsive probe) fall back to `--api-key`. The .NET SDK probe runs only after every early-exit condition, and printed push lines name the channel, never the key value.
            - **`dotnet-releaser` migration skill** — `skills/dotnet-releaser-to-releasegen-migration/` guides migrating a dotnet-releaser (TOML) pipeline to ReleaseGen: TOML config inventory, manifest translation, a coverage report, a dry-run validation gate, and a CI rewrite. It is backed by a mapping table that classifies each surface as Mapped, Manual action required, or No ReleaseGen equivalent.
            - **`releasegen build --rids &lt;rids&gt;`** — a comma-separated subset of the manifest's `runtimeIdentifiers` for the current invocation only (same escape posture as `--preset`): it is never written to the manifest and may only narrow the manifest's declared set, never adding a RID the manifest does not specify. Entries match case-insensitively, de-duplicate, and keep the manifest's spelling; an empty/blank/out-of-set value is refused with a named error before any publish is planned.

            ## Changed
            - Pinned `Microsoft.Build` package to 18.9.6 since newer versions don't support .NET 10
            - Dependencies: Meziantou.Analyzer to 3.0.322.
            - Documentation for commands, stage handoff, and trusted publishing now describes how the API key reaches the spawned push (environment on .NET SDK 10.0.300+, `--api-key` argument otherwise).</PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <AssemblyName>ReleaseGen</AssemblyName>
        <RootNamespace>ReleaseGen.Cli</RootNamespace>
        <AssemblyVersion>0.4.0</AssemblyVersion>
        <FileVersion>0.4.0</FileVersion>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Meziantou.Analyzer">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
      <PackageReference Include="Spectre.Console" />
      <PackageReference Include="System.CommandLine" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ReleaseGenLib\ReleaseGenLib.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Localizations\Resources.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Localizations\Resources.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Resources.resx</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
