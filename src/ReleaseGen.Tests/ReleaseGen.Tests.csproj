<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
      <PackageReference Include="TUnit" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ReleaseGenCli\ReleaseGenCli.csproj" />
      <ProjectReference Include="..\ReleaseGenLib\ReleaseGenLib.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!-- Captured push-output fixtures ride along to the test output, where the scanner
           tests read them via AppContext.BaseDirectory. -->
      <None Update="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
