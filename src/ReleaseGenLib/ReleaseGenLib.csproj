<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsTrimmable>true</IsTrimmable>
        <RepositoryUrl>https://github.com/alastairlundy/ReleaseGen</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <IncludeSymbols>true</IncludeSymbols>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <IsTrimmable>true</IsTrimmable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>ReleaseGenLib</Title>
        <Authors>Alastair Lundy</Authors>
        <Copyright>Copyright (c) 2026 Alastair Lundy</Copyright>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CliInvoke" Version="2.8.5" />
      <PackageReference Include="CliInvoke.Core" Version="2.8.5" />
      <PackageReference Include="Microsoft.Build" Version="18.0.2" />
    </ItemGroup>

</Project>
