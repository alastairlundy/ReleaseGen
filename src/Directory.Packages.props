<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="CliInvoke" Version="3.1.0" />
    <PackageVersion Include="CliInvoke.Core" Version="3.1.0" />
    <!-- Pinned: from 18.10.1 the package ships only net11.0 + net472 assets (net10.0 was
         dropped in dotnet/msbuild#14455), so a net10.0 project silently falls back to the
         .NET Framework build (NU1701). Keep this at 18.9.6 — the newest published
         net10.0 build — for as long as ReleaseGen targets net10.0 (see CONTRIBUTING.md). -->
    <PackageVersion Include="Microsoft.Build" Version="18.9.6" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.322" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
    <PackageVersion Include="TUnit" Version="1.81.10" />
  </ItemGroup>
</Project>