<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="CliInvoke" Version="3.2.0-beta.1" />
    <PackageVersion Include="CliInvoke.Core" Version="3.2.0-beta.1" />
    <!-- Microsoft.Build is versioned per TFM: from 18.10.1 the package ships only net11.0 +
         net472 assets (net10.0 was dropped in dotnet/msbuild#14455), so a net10.0 project
         silently falls back to the .NET Framework build (NU1701). ReleaseGenLib's net10.0
         flavor therefore compiles against 18.9.6 — the newest published net10.0 build —
         while its net11.0 flavor takes the current release (see CONTRIBUTING.md). -->
    <PackageVersion Include="Microsoft.Build" Version="18.9.6" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.Build" Version="18.12.2" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.342" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
  </ItemGroup>
</Project>